root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
max_line_length = 100
tab_width = 4
ij_java_indent_size = 4
ij_java_tab_size = 4
ij_java_continuation_indent_size = 4
ij_java_use_tab_character = false


[*.{gradle,yml,yaml}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2
